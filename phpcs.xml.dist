<?xml version="1.0"?>
<ruleset name="WC Theme Developer Kit">
	<description>WordPress Coding Standards for WooCommerce Theme Developer Kit</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>*/assets/js/blocks/index.js</exclude-pattern>
	<exclude-pattern>*/assets/js/woo/*</exclude-pattern>
	<exclude-pattern>*/assets/*.js</exclude-pattern>

	<rule ref="WordPress">
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
	</rule>

	<rule ref="WordPress.Security.EscapeOutput">
		<properties>
			<property name="customEscapingFunctions" type="array">
				<element value="wc_tdk_print_template_html"/>
			</property>
		</properties>
	</rule>

	<config name="text_domain" value="wc-tdk"/>
	<config name="minimum_supported_wp_version" value="6.0"/>
</ruleset>
